__pycache__/
*.pyc
.pytest_cache/
.venv/
*.egg-info/
src/*.egg-info/

# Raw downloaded BFCL data is fetched by src/ingest_bfcl.py, not committed.
data/raw/bfcl/*
!data/raw/bfcl/.gitkeep

# Large generated artifacts (recreated by later phases).
results/raw/*
results/processed/*
!results/raw/.gitkeep
!results/processed/.gitkeep

# Materialized condition files: fully regenerable from the frozen catalog +
# tasks + histories + seeds (build_conditions.py / phase4_build_final_conditions.py),
# and large enough (each row inlines the full history) to blow past GitHub's
# file-size limits -- e.g. final_grid.jsonl is ~230MB.
data/conditions/*
!data/conditions/.gitkeep
